{
  "name": "flavour-heaven-ordering",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "check": "npm run db:generate && npm run api:check && npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "api:dev": "cd apps/api && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "api:check": "python -m compileall apps/api",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
